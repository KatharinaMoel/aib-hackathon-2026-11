# Copy to .env and fill in; never commit .env. Commands that need keys: `uv run --env-file .env <command>`.
# Names only, never real values. Add a line when code needs a new key. See docs/FILES.md.
# Which model provider we use is decided at 15:30 (AGENTS.md, "Stack and commands").
# Key for the model (LLM) API.
LLM_API_KEY=
# Address of the model API, if the provider needs one (e.g. an OpenAI-compatible endpoint); empty = provider default.
LLM_BASE_URL=
# Key for Tavily, the web search API (https://tavily.com); keys come from the event partners.
TAVILY_API_KEY=
